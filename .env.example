HTTP_ADDR=:8080
# KUBECONFIG=/home/user/.kube/config
ARGOCD_NAMESPACE=argocd
AUDIT_DB_PATH=./data/audit.db
PROMETHEUS_URL=
GRAFANA_DASHBOARD_URL=
AUTH_USER_HEADER=X-authentik-username
AUTH_EMAIL_HEADER=X-authentik-email
# Local dev only — never set in cluster:
DEV_AUTH_USER=dev
STATIC_DIR=
RESTIC_BINARY=restic
# Defaults to <dir of AUDIT_DB_PATH>/restic-cache; persists restic repo index across restarts.
# RESTIC_CACHE_DIR=./data/restic-cache
LOG_LEVEL=info
K8UP_GLOBAL_SECRET_NAMESPACE=k8up
K8UP_GLOBAL_SECRET_NAME=k8up-global

# --- Notifications (optional) ---
# ntfy: enabled when NTFY_TOPIC is set. Alerts on job failures, restore
# outcomes, and interrupted restores. Test with: POST /api/v1/notify/test
# NTFY_URL=https://ntfy.sh
# NTFY_TOPIC=
# NTFY_TOKEN=
# Email: enabled when SMTP_HOST + SMTP_FROM + SMTP_TO are all set.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_TLS=starttls   # starttls | tls (implicit, port 465) | none
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=k8up-btl@example.com
# SMTP_TO=you@example.com,other@example.com
# Also notify on successful GUI restores (failures always notify):
# NOTIFY_RESTORE_SUCCESS=true

# SQL dump recovery. Restore command resolution: pod annotation
# (k8up-btl.local/restore-command) -> SQL_RESTORE_CMD_<engine> -> derived from
# the pod's k8up.io/backupcommand. Set REQUIRE_ANNOTATION to disable fallbacks.
# SQL_RESTORE_CMD_POSTGRES=psql -v ON_ERROR_STOP=1
# SQL_RESTORE_CMD_POSTGRES_ALL=
# SQL_RESTORE_CMD_MARIADB=
# SQL_RESTORE_CMD_MYSQL=
# SQL_RESTORE_REQUIRE_ANNOTATION=false
# Bound on the pre-recovery safety backup wait:
# SAFETY_BACKUP_TIMEOUT=30m
